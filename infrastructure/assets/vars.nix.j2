# Generated by homelab-router-infrastructure from assets/sites/[<order>-]<site>.yml: do not edit.
# Schema (types, defaults, validation): nix/modules/options/ of this repo.
{{- /*
Data: .Router = *site.Config (the parsed site file), .Netbird = *netbird.Config (core stack),
.SSHKeys = []string (public keys of the deploy user: the static ones from assets/ssh/*.pub
plus the site's generated deploy key), .HostKey = string (the router's generated public SSH host
key; empty for a disabled site).

Conventions:
- Nix lists are separated by whitespace, never by commas.
- text/template prints pointers dereferenced, but a field access through a nil pointer is a
  render error. Optional (omitempty) values are therefore only accessed inside `with`/`if`,
  and an unset optional value is not rendered at all: the Nix default applies, and a value
  Nix requires but the site file lacks fails the evaluation ("used but not defined")
  instead of rendering "<nil>".
- `with` on an empty list is false: an empty optional list is not rendered either.
- `and`/`or` short-circuit, so `and .A .A.B` is safe when .A is nil.
- Inside `range`/`with` the dot is the element; the root is `$`.
- Strings are not escaped (decided: no Nix-literal function until a real value needs it). Inside
  "...": `"` ends the string, `${` interpolates and `\` starts an escape (an unknown one such as `\d`
  silently drops the backslash), so a value with a backslash needs it doubled in the site file
  (`/ads\\d+\\.example/`; four in a double-quoted YAML string). Inside the raw firewall rules ('' ''):
  `''` and `${`. In practice only DNS extraRules (regex filters) are affected.
*/}}
{
  router = {
    {{- /* Always rendered: a site file is disabled unless it says `enabled: true`. */}}
    meta.deployable = {{ .Router.IsEnabled }};
    {{- with .Router.DeployOrder }}
    meta.deployOrder = {{ . }};
    {{- end }}

    site = {
      name = "{{ .Router.Name }}";
      hostname = "{{ .Router.Name }}";
      domain = "{{ .Router.Network.Domain }}";
    };

    mgmt = {
      address = "{{ with .Router.Network.ManagementAddress }}{{ . }}{{ else }}{{ .Router.Network.LAN.V4.Address }}{{ end }}";
      sshKeys = [
        {{- range .SSHKeys }}
        "{{ . }}"
        {{- end }}
      ];
      {{- with .HostKey }}
      hostKey = "{{ . }}";
      {{- end }}
    };

    trusted = {
      v4 = [
        {{- range .Router.Network.TrustedNetworks.V4 }}
        "{{ . }}"
        {{- end }}
      ];
      v6 = [
        {{- range .Router.Network.TrustedNetworks.V6 }}
        "{{ . }}"
        {{- end }}
      ];
      {{- with .Router.Network.TrustedNetworks.WAN }}
      onWan = {{ . }};
      {{- end }}
    };

    hardware = {
      profile = "{{ .Router.Hardware.Profile }}";
      disk = "{{ .Router.Hardware.Disk }}";
      {{- with .Router.Hardware.UPS }}
      {{- with .Enabled }}
      ups.enable = {{ . }};
      {{- end }}
      {{- with .Name }}
      ups.name = "{{ . }}";
      {{- end }}
      {{- with .Driver }}
      ups.driver = "{{ . }}";
      {{- end }}
      {{- with .Port }}
      ups.port = "{{ . }}";
      {{- end }}
      {{- end }}
    };

    {{- with .Router.System }}
    {{- with .Watchdog }}
    system.watchdog = "{{ . }}";
    {{- end }}
    {{- with .GC }}
    {{- with .OlderThan }}
    system.gc.olderThan = "{{ . }}";
    {{- end }}
    {{- with .Keep }}
    system.gc.keep = {{ . }};
    {{- end }}
    {{- end }}
    {{- end }}

    wan = {
      mac = "{{ .Router.Network.WAN.MAC }}";
      iface = "{{ .Router.Network.WAN.Interface }}";
      {{- with .Router.Network.WAN.VLAN }}
      vlan = {{ . }};
      {{- end }}
      {{- with .Router.Network.WAN.Shaping }}
      {{- with .Upload }}
      shaping.upload = "{{ . }}";
      {{- end }}
      {{- end }}
      {{- with .Router.Network.WAN.V4 }}
      v4 = {
        method = "{{ .Method }}";
        {{- if eq .Method "static" }}
        address = "{{ .Address }}/{{ .Netmask }}";
        {{- with .Gateway }}
        gateway = "{{ . }}";
        {{- end }}
        {{- end }}
        {{- with .Announce }}
        announce = {{ . }};
        {{- end }}
      };
      {{- end }}
      v6 = {
        {{- with .Router.Network.WAN.V6 }}
        method = "{{ .Method }}";
        {{- if eq .Method "static" }}
        address = "{{ .Address }}/{{ .Netmask }}";
        {{- with .Gateway }}
        gateway = "{{ . }}";
        {{- end }}
        {{- end }}
        {{- with .Announce }}
        announce = {{ . }};
        {{- end }}
        {{- else }}
        method = "none";
        {{- end }}
      };
    };

    lan = {
      mac = "{{ .Router.Network.LAN.MAC }}";
      iface = "{{ .Router.Network.LAN.Interface }}";
      {{- with .Router.Network.LAN.V4 }}
      v4 = "{{ .Address }}/{{ .Netmask }}";
      v4Net = "{{ .Network }}/{{ .Netmask }}";
      {{- end }}
      {{- with .Router.Network.LAN.V6 }}
      v6 = "{{ .Address }}/{{ .Netmask }}";
      v6Net = "{{ .Network }}/{{ .Netmask }}";
      v6Supernet = "{{ .Supernet }}";
      {{- end }}
    };

    {{- /* A public LAN prefix is routed as it is; a ULA LAN reaches the internet through NAT66. */}}
    nat66.enable = {{ not .Router.Network.LAN.V6.Public }};

    {{- with .Router.Network.AdditionalRoutableNetworks }}
    publicV6 = [
      {{- range . }}
      {
        prefix = "{{ .Prefix }}";
        anchor = "{{ .Anchor }}";
      }
      {{- end }}
    ];
    {{- end }}

    {{- with .Router.Network.Loopbacks }}
    loopbacks = [
      {{- range . }}
      {
        address = "{{ .Address }}";
        {{- with .Announce }}
        announce = {{ . }};
        {{- end }}
      }
      {{- end }}
    ];
    {{- end }}

    dhcp = {
      pool4 = "{{ .Router.DHCP.V4.Start }} - {{ .Router.DHCP.V4.End }}";
      pool6 = "{{ .Router.DHCP.V6.Start }} - {{ .Router.DHCP.V6.End }}";
      reservations4 = [
        {{- range $r := .Router.DHCP.Reservations }}
        {{- with .V4 }}
        {
          hostname = "{{ $r.Hostname }}";
          {{- with $r.MAC }}
          mac = "{{ . }}";
          {{- end }}
          ip = "{{ . }}";
        }
        {{- end }}
        {{- end }}
      ];
      reservations6 = [
        {{- range $r := .Router.DHCP.Reservations }}
        {{- with .V6 }}
        {
          hostname = "{{ $r.Hostname }}";
          {{- with $r.DUID }}
          duid = "{{ . }}";
          {{- end }}
          ip = "{{ . }}";
        }
        {{- end }}
        {{- end }}
      ];
    };

    {{- with .Router.Firewall }}
    {{- with .Forwards }}
    {{- with .V4 }}
    firewall.forwards.v4 = [
      {{- range . }}
      {
        proto = "{{ .Proto }}";
        ports = [ {{ range .Ports }}{{ . }} {{ end }}];
        to = "{{ .To }}";
        {{- with .From }}
        from = [ {{ range . }}"{{ . }}" {{ end }}];
        {{- end }}
      }
      {{- end }}
    ];
    {{- end }}

    {{- with .V6 }}
    firewall.forwards.v6 = [
      {{- range . }}
      {
        proto = "{{ .Proto }}";
        ports = [ {{ range .Ports }}{{ . }} {{ end }}];
        to = "{{ .To }}";
        {{- with .From }}
        from = [ {{ range . }}"{{ . }}" {{ end }}];
        {{- end }}
      }
      {{- end }}
    ];
    {{- end }}
    {{- end }}

    {{- /* Only the fields set in the site file: the rest keeps the default service's values. */}}
    {{- range $name, $service := .Services }}
    firewall.services."{{ $name }}" = {
      {{- with $service.Enabled }}
      enable = {{ . }};
      {{- end }}
      {{- with $service.Proto }}
      proto = "{{ . }}";
      {{- end }}
      {{- with $service.Ports }}
      ports = [ {{ range . }}{{ . }} {{ end }}];
      {{- end }}
      {{- with $service.From }}
      from = [ {{ range . }}"{{ . }}" {{ end }}];
      {{- end }}
    };
    {{- end }}

    {{- with .ExtraInputRules }}
    firewall.extraInputRules = ''
{{ . }}
    '';
    {{- end }}

    {{- with .ExtraForwardRules }}
    firewall.extraForwardRules = ''
{{ . }}
    '';
    {{- end }}

    {{- with .LogDrops }}
    {{- with .Enabled }}
    firewall.logDrops.enable = {{ . }};
    {{- end }}
    {{- with .Rate }}
    firewall.logDrops.rate = "{{ . }}";
    {{- end }}
    {{- with .Burst }}
    firewall.logDrops.burst = {{ . }};
    {{- end }}
    {{- end }}
    {{- end }}

    {{- with .Router.Security }}
    {{- with .CrowdSec }}
    {{- with .Enabled }}
    security.crowdsec.enable = {{ . }};
    {{- end }}
    {{- with .BanDuration }}
    security.crowdsec.banDuration = "{{ . }}";
    {{- end }}
    {{- end }}
    {{- end }}

    {{- with .Router.Observability }}
    {{- with .Monitoring }}
    {{- with .Prometheus }}
    {{- with .Enabled }}
    observability.monitoring.prometheus.enable = {{ . }};
    {{- end }}
    {{- with .Exporters }}
    observability.monitoring.prometheus.exporters = [ {{ range . }}"{{ . }}" {{ end }}];
    {{- end }}
    {{- end }}
    {{- end }}
    {{- with .Logging }}
    {{- with .Vector }}
    {{- with .Enabled }}
    observability.logging.vector.enable = {{ . }};
    {{- end }}
    {{- with .Address }}
    observability.logging.vector.address = "{{ . }}";
    {{- end }}
    {{- end }}
    {{- end }}
    {{- end }}

    {{- with .Router.DNS }}
    {{- with .ConditionalForwards }}
    dns.conditionalForwards = [
      {{- range $domain, $server := . }}
      "[/{{ $domain }}/]{{ $server }}"
      {{- end }}
    ];
    {{- end }}

    {{- with .ExtraRules }}
    dns.extraRules = [
      {{- range . }}
      "{{ . }}"
      {{- end }}
    ];
    {{- end }}
    {{- end }}

    {{- with .Router.Transport }}
    {{- with .NetBird }}
    transport.netbird = {
      {{- with .Enabled }}
      enable = {{ . }};
      {{- end }}
      managementUrl = "{{ $.Netbird.Address }}";
      {{- with .Port }}
      port = {{ . }};
      {{- end }}
      {{- with .MTU }}
      mtu = {{ . }};
      {{- end }}
    };
    {{- end }}
    {{- end }}

    {{- with .Router.BGP }}
    {{- with .EVPN }}
    evpn = {
      {{- with .Enabled }}
      enable = {{ . }};
      {{- end }}
      hubVtep = "{{ $.Netbird.HubIP }}";
    };
    {{- end }}

    bgp = {
      {{- with .Enabled }}
      enable = {{ . }};
      {{- end }}
      asn = {{ .ASN }};
      routerId = "{{ $.Router.Network.LAN.V4.Address }}";
      originate4 = [ "{{ $.Router.Network.LAN.V4.Network }}/{{ $.Router.Network.LAN.V4.Netmask }}" ];
      {{- /* A public LAN prefix belongs to the ISP: never announced (publicV6 and loopbacks are, by Nix). */}}
      originate6 = [
        {{- with $.Router.Network.LAN.V6 }}
        {{- if not .Public }}
        "{{ .Network }}/{{ .Netmask }}"
        {{- end }}
        {{- end }}
      ];
      peers = [
        {{- range .Peers }}
        {
          name = "{{ .Name }}";
          address = "{{ .Address }}";
          remoteAs = {{ .RemoteASN }};
          {{- with .Interface }}
          iface = "{{ . }}";
          {{- end }}
          {{- with .BFD }}
          bfd = {{ . }};
          {{- end }}
          {{- with .DisableConnectedCheck }}
          disableConnectedCheck = {{ . }};
          {{- end }}
          {{- with .NextHopSelf }}
          nextHopSelf = {{ . }};
          {{- end }}
          {{- with .Multihop }}
          multihop = {{ . }};
          {{- end }}
          {{- with .V4 }}
          v4 = {{ . }};
          {{- end }}
          {{- with .V6 }}
          v6 = {{ . }};
          {{- end }}
          {{- with .InPolicy }}
          inPolicy = "{{ . }}";
          {{- end }}
          {{- with .OutPolicy }}
          outPolicy = "{{ . }}";
          {{- end }}
          {{- with .Transit }}
          transit = {{ . }};
          {{- end }}
        }
        {{- end }}
      ];
    };
    {{- end }}
  };
}
