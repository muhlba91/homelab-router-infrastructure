{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "github>muhlba91/renovate-config",
        "github>muhlba91/renovate-config:automerge(patch)",
        "github>muhlba91/renovate-config:automerge(minor)"
    ],
    "timezone": "Europe/Vienna",
    "enabledManagers": [
        "dockerfile",
        "github-actions",
        "gomod",
        "nix",
        "pre-commit"
    ],
    "nix": {
        "enabled": true
    },
    "lockFileMaintenance": {
        "enabled": true,
        "automerge": true,
        "schedule": [
            "after 8am and before 12pm on sunday"
        ]
    },
    "packageRules": [
        {
            "description": "A NixOS release (nixpkgs branch nixos-YY.MM) needs a review: never automerge; lock file maintenance stays automerged",
            "matchManagers": [
                "nix"
            ],
            "matchDepNames": [
                "nixpkgs"
            ],
            "matchUpdateTypes": [
                "major",
                "minor"
            ],
            "automerge": false
        }
    ]
}
